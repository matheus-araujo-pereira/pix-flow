# Database Configuration (Neon Serverless PostgreSQL)
DB_URL=jdbc:postgresql://ep-restless-shadow-b6al0uuy-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=npg_1CeGTwMtzsR9

# Server & Profile
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Messaging Provider: in-memory (Render Free Tier) | sqs (AWS / LocalStack)
PIXFLOW_MESSAGING_PROVIDER=in-memory

# AWS SQS Configuration (Only required if PIXFLOW_MESSAGING_PROVIDER=sqs)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_SQS_QUEUE_NAME=pix-settlement-queue
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/pix-settlement-queue
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# CORS Configuration (Permite conexões do Vercel e Localhost)
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

